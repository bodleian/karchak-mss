               <msContents>
                  <msItem xml:id="Tib_blockbooks_a_22_1-item1">
                     <title key="work_894" xml:lang="bo">mdo chen po</title>
                     <title key="work_894" xml:lang="510 x 100">མདོ་ཆེན་པོ་སྟོང་པ་ཉིད་ཅེས་བྱ་བ་བཞུགས་སོ༎</title>
                     <title type="margin" xml:lang="bo">rgya gar skad du / shUn ya tA nA ma ma hA sU tra / bod skad du / mdo chen po stong pa nyid ces bya ba / dkon mchog gsum la phyag 'tshal lo / 'di skad bdag gis thos pa dus gcig na / bcom ldan 'das mnyan yod kyi shar gyi kun dga' ra ba na / ri dags 'dzin gyi ma'i khang bzangs na bzhugs so / de nas tshe dang ldan pa kun dga' bo snga dro nang du yang dag 'jog las langs nas / bcom ldan 'das ga la ba der song ste / phyin nas bcom ldan 'das kyi zhabs la mgo bos phyag 'tshal te / phyogs gcig tu 'dug go /</title>
                     <title type="margin" xml:lang="510 x 100">མདོ་ཆེན་པོ</title>
                     <author key="person_2017054714">
                        <persName xml:lang="bo">mdo chen po stong pa nyid ces bya ba bzhugs so// Śūnyatānāmahāsūtra</persName>
                     </author>
                     <note>"Derge: 0291 Peking: 0957"</note>
                     <incipit xml:lang="bo">de nas tshe dang ldan pa kun dga' bos / bcom ldan 'das kyi bka' stsal pa la mngon par bstod cing rjes su yi rang bar byas nas / bcom ldan 'das kyi zhabs la mgo bos phyag 'tshal te / bcom ldan 'das kyi spyan snga nas phyir dong ngo / mdo chen po stong pa nyid ces bya ba rdzogs so / /</incipit>
                     <explicit xml:lang="bo">rgya gar gyi mkhan po dzi na mi tra dang / pradz+nyA bar ma dang / zhu chen gyi lo ts+tsha ba ban d+he ye shes sde la sogs pas / bsgyur cing zhus te gtan la phab pa'o / / zhus dag / mang+lam</explicit>
                     <colophon xml:lang="bo">This is one of the Mahāsūtras.</colophon>
                  </msItem>
